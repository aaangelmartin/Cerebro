{"openapi":"3.0.3","info":{"title":"v07 Market","version":"1"},"paths":{"/plaza/api/health":{"get":{"summary":"Is the market up and open.","x-who":"anyone","x-screen":"-","responses":{"200":{"description":"ok"}},"x-example":"/plaza/static/fixtures/health.json"}},"/plaza/api/openapi.json":{"get":{"summary":"This list, for machines.","x-who":"anyone","x-screen":"docs","responses":{"200":{"description":"ok"}}}},"/plaza/api/status":{"get":{"summary":"Clock, tick, seconds to the next tick, and whether the game, the market, the matchmaker and your agent are on.","x-who":"anyone","x-screen":"every screen","responses":{"200":{"description":"ok"}},"x-example":"/plaza/static/fixtures/status.json"}},"/plaza/api/stats":{"get":{"summary":"What the venue has closed so far.","x-who":"anyone","x-screen":"landing","responses":{"200":{"description":"ok"}},"x-example":"/plaza/static/fixtures/stats.json"}},"/plaza/api/teams":{"get":{"summary":"Every team with its counts.","x-who":"anyone","x-screen":"market","responses":{"200":{"description":"ok"}},"x-example":"/plaza/static/fixtures/teams.json"}},"/plaza/api/team/{team}":{"get":{"summary":"One team's public sheet: what it can part with and what it wants.","x-who":"anyone","x-screen":"market","responses":{"200":{"description":"ok"}},"x-example":"/plaza/static/fixtures/team.json"},"put":{"summary":"Publish your whole sheet: wants, spares, for_sale, have, with limits.","x-who":"agent","x-screen":"cards","responses":{"200":{"description":"ok"}},"requestBody":{"content":{"application/json":{"example":{"wants":["LAV-11",{"ref":"SAL-10","max":80}],"spares":["MAL-01"],"for_sale":[{"ref":"RET-03","price":12,"min":9}],"have":["MAL-01","RET-03","SAL-01"]}}}}}},"/plaza/api/market":{"get":{"summary":"Every card: who holds it, who wants it, best ask and bid, last price.","x-who":"anyone","x-screen":"market","responses":{"200":{"description":"ok"}},"x-example":"/plaza/static/fixtures/market.json"}},"/plaza/api/card/{ref}":{"get":{"summary":"One card