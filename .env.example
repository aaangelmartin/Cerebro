# The Bazaar (Causa Prima hackathon) — https://bazaar.causaprima.ai
BAZAAR_BASE_URL=https://bazaar.causaprima.ai
# Clave de equipo (cabecera X-Team-Key)
BAZAAR_TEAM_KEY=
# Opcional: solo si os dan rol de broker (cabecera X-Broker-Key)
BAZAAR_BROKER_KEY=

# Claude API, si el agente negocia con un LLM
ANTHROPIC_API_KEY=

# Shared dashboard (ngrok basic auth)
DASHBOARD_USER=team10
DASHBOARD_PASSWORD=
# Token for teammates bots (use as BAZAAR_KEY with BAZAAR_URL=<ngrok url>)
GATEWAY_TOKEN=
